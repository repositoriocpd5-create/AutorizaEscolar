# Copie para .env e ajuste. NUNCA versione o .env real.
FLASK_APP=wsgi.py

# Segredos (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Pepper do hash de CPF. Defina UMA vez antes de popular o banco e nunca mais altere.
CPF_PEPPER=troque-por-outro-valor-aleatorio-longo

# Banco (padrão: SQLite em instance/passeios.db). Produção: PostgreSQL.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/passeios

INSTITUICAO_NOME=Secretaria Municipal de Educação
TIMEZONE=America/Sao_Paulo
# URL pública usada no QR Code dos PDFs (obrigatório em produção)
PUBLIC_BASE_URL=http://localhost:5000

# Autenticação do responsável: nenhum | data_nascimento
AUTH_SEGUNDO_FATOR=nenhum
SESSAO_MINUTOS=30

# Demonstração (desligue em produção)
DEMO_MODE=true
DEMO_CPFS=00000000000
# DEMO_PASSEIO_DATA=2026-10-20
DEMO_ADMIN_LOGIN=admin
DEMO_ADMIN_SENHA=demo-admin-2026
DEMO_ESCOLA_LOGIN=escola.exemplo
DEMO_ESCOLA_SENHA=demo-escola-2026

# Produção
SESSION_COOKIE_SECURE=false
FORCAR_HTTPS=false
PROXY_FIX=false
REGISTRAR_IP=true
REGISTRAR_USER_AGENT=true
